{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robchristie/emuella-testdata/schema/suite.schema.json",
  "title": "Emuella corpus suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "revision", "name", "description", "layer",
    "purposes", "gating", "missing_policy", "packs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "layer": { "type": "integer", "minimum": 1, "maximum": 3 },
    "purposes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gating": { "type": "boolean" },
    "missing_policy": { "enum": ["fail", "skip"] },
    "packs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "extensions", "expected", "classifications"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "extensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": [".j2k", ".htj2k", ".jp2", ".jph"] }
        },
        "expected": { "enum": ["accept", "reject"] },
        "diagnostic_contains": { "type": "string", "minLength": 1 },
        "classifications": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "cohort"],
            "oneOf": [
              { "required": ["path"] },
              { "required": ["path_prefix"] }
            ],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "path_prefix": { "type": "string", "minLength": 1 },
              "format": { "enum": ["j2k", "htj2k", "jp2", "jph"] },
              "cohort": { "type": "string", "minLength": 1 }
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "expected"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "expected": { "enum": ["accept", "reject"] },
              "diagnostic_contains": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "decoded_pixel_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "standard", "clauses", "retrieval_commit", "cases"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "standard": { "type": "string", "minLength": 1 },
        "clauses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "retrieval_commit": {
          "type": "string", "pattern": "^[0-9a-f]{40}$"
        },
        "cases": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "input", "reference", "component", "resolution_reduction",
              "width", "height", "bits_per_sample", "signed",
              "peak_error_limit", "mean_squared_error_limit"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
              "input": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 },
              "component": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "resolution_reduction": { "type": "integer", "minimum": 0, "maximum": 255 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "bits_per_sample": { "type": "integer", "minimum": 1, "maximum": 32 },
              "signed": { "type": "boolean" },
              "peak_error_limit": { "type": "integer", "minimum": 0 },
              "mean_squared_error_limit": { "type": "number", "minimum": 0 }
            }
          }
        },
        "choice_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "input", "minimum_passing_alternatives", "alternatives"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
              "input": { "type": "string", "minLength": 1 },
              "minimum_passing_alternatives": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "alternatives": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id", "reference", "component", "resolution_reduction",
                    "width", "height", "bits_per_sample", "signed",
                    "peak_error_limit", "mean_squared_error_limit"
                  ],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
                    "reference": { "type": "string", "minLength": 1 },
                    "component": { "type": "integer", "minimum": 0, "maximum": 65535 },
                    "resolution_reduction": { "type": "integer", "minimum": 0, "maximum": 255 },
                    "width": { "type": "integer", "minimum": 1 },
                    "height": { "type": "integer", "minimum": 1 },
                    "bits_per_sample": { "type": "integer", "minimum": 1, "maximum": 32 },
                    "signed": { "type": "boolean" },
                    "peak_error_limit": { "type": "integer", "minimum": 0 },
                    "mean_squared_error_limit": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
