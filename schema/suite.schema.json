{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robchristie/emuella-testdata/schema/suite.schema.json",
  "title": "Emuella corpus suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "revision", "name", "description", "layer",
    "purposes", "gating", "missing_policy", "packs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "layer": { "type": "integer", "minimum": 1, "maximum": 3 },
    "purposes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gating": { "type": "boolean" },
    "missing_policy": { "enum": ["fail", "skip"] },
    "packs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "extensions", "expected", "classifications"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "extensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": [".j2k", ".htj2k", ".jp2", ".jph"] }
        },
        "expected": { "enum": ["accept", "reject"] },
        "diagnostic_contains": { "type": "string", "minLength": 1 },
        "classifications": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "cohort"],
            "oneOf": [
              { "required": ["path"] },
              { "required": ["path_prefix"] }
            ],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "path_prefix": { "type": "string", "minLength": 1 },
              "format": { "enum": ["j2k", "htj2k", "jp2", "jph"] },
              "cohort": { "type": "string", "minLength": 1 }
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "expected"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "expected": { "enum": ["accept", "reject"] },
              "diagnostic_contains": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
