{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robchristie/emuella-testdata/schema/suite.schema.json",
  "title": "Emuella corpus suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "revision", "name", "description", "layer",
    "purposes", "gating", "missing_policy", "packs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
    "revision": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "layer": { "type": "integer", "minimum": 1, "maximum": 3 },
    "purposes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gating": { "type": "boolean" },
    "missing_policy": { "enum": ["fail", "skip"] },
    "packs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "extensions", "expected", "classifications"],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "extensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": [".j2k", ".htj2k", ".jp2", ".jph"] }
        },
        "expected": { "enum": ["accept", "reject"] },
        "diagnostic_contains": { "type": "string", "minLength": 1 },
        "classifications": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "cohort"],
            "oneOf": [
              { "required": ["path"] },
              { "required": ["path_prefix"] }
            ],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "path_prefix": { "type": "string", "minLength": 1 },
              "format": { "enum": ["j2k", "htj2k", "jp2", "jph"] },
              "cohort": { "type": "string", "minLength": 1 }
            }
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "expected"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "expected": { "enum": ["accept", "reject"] },
              "diagnostic_contains": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "decoded_pixel_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_id", "standard", "clauses", "retrieval_commit", "cases"],
      "allOf": [
        {
          "if": {
            "required": ["derived_sets"],
            "properties": { "derived_sets": { "minItems": 1 } }
          },
          "then": { "required": ["output_normalisation"] }
        }
      ],
      "properties": {
        "pack_id": { "type": "string", "minLength": 1 },
        "standard": { "type": "string", "minLength": 1 },
        "clauses": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "retrieval_commit": {
          "type": "string", "pattern": "^[0-9a-f]{40}$"
        },
        "output_normalisation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["order_dependent", "order_independent"],
          "properties": {
            "order_dependent": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "enum": [
                  "resolution-reduction", "recover-first-codestream-component",
                  "round-to-nearest-integer", "clip-to-declared-sample-range",
                  "reference-bit-depth-arithmetic-shift",
                  "reference-grid-subsampling", "upper-left-reference-crop"
                ]
              }
            },
            "order_independent": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {
                "enum": [
                  "planar-component-deinterleave", "big-endian-byte-order",
                  "sign-extend-to-byte-boundary"
                ]
              }
            }
          }
        },
        "cases": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "input", "reference", "component", "resolution_reduction",
              "width", "height", "bits_per_sample", "signed",
              "peak_error_limit", "mean_squared_error_limit"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
              "input": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 },
              "component": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "output_window": { "type": "boolean" },
              "output_origin_x": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "output_origin_y": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "resolution_reduction": { "enum": [0, 1, 2, 3, 4, 5] },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "bits_per_sample": { "type": "integer", "minimum": 1, "maximum": 32 },
              "signed": { "type": "boolean" },
              "peak_error_limit": { "type": "integer", "minimum": 0 },
              "mean_squared_error_limit": { "type": "number", "minimum": 0 }
            }
          }
        },
        "choice_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "input", "minimum_passing_alternatives", "alternatives"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
              "input": { "type": "string", "minLength": 1 },
              "minimum_passing_alternatives": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "alternatives": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id", "reference", "component", "resolution_reduction",
                    "output_origin_x", "output_origin_y",
                    "width", "height", "bits_per_sample", "signed",
                    "peak_error_limit", "mean_squared_error_limit"
                  ],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
                    "reference": { "type": "string", "minLength": 1 },
                    "component": { "type": "integer", "minimum": 0, "maximum": 65535 },
                    "resolution_reduction": { "enum": [0, 1] },
                    "output_origin_x": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                    "output_origin_y": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                    "width": { "type": "integer", "minimum": 1 },
                    "height": { "type": "integer", "minimum": 1 },
                    "bits_per_sample": { "type": "integer", "minimum": 1, "maximum": 32 },
                    "signed": { "type": "boolean" },
                    "peak_error_limit": { "type": "integer", "minimum": 0 },
                    "mean_squared_error_limit": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          }
        },
        "derived_sets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "profile", "compliance_class", "selection", "cases"],
            "properties": {
              "id": { "const": "DS0" },
              "profile": { "const": 0 },
              "compliance_class": { "const": 0 },
              "selection": { "const": "greatest-b-magb-not-exceeding-m-magb" },
              "cases": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "coding_mode", "reference_case_id", "variants"],
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
                    "coding_mode": { "enum": ["HTONLY", "HTMIX"] },
                    "reference_case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
                    "variants": {
                      "type": "array", "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["input", "b_magb"],
                        "properties": {
                          "input": { "type": "string", "minLength": 1 },
                          "b_magb": { "type": "integer", "minimum": 0, "maximum": 255 },
                          "component_limits": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["component", "peak_error_limit", "mean_squared_error_limit"],
                              "properties": {
                                "component": { "type": "integer", "minimum": 0, "maximum": 65535 },
                                "peak_error_limit": { "type": "integer", "minimum": 0 },
                                "mean_squared_error_limit": { "type": "number", "minimum": 0 }
                              }
                            }
                          },
                          "alternative_limits": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": ["alternative_id", "peak_error_limit", "mean_squared_error_limit"],
                              "properties": {
                                "alternative_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$" },
                                "peak_error_limit": { "type": "integer", "minimum": 0 },
                                "mean_squared_error_limit": { "type": "number", "minimum": 0 }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
