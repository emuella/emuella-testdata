{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robchristie/emuella-testdata/schema/pack.schema.json",
  "title": "Emuella corpus pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "name", "description",
    "review_state", "kind", "codecs", "purposes", "license", "rights",
    "materialization"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "review_state": {
      "enum": ["planned", "reviewed", "locked", "withdrawn"]
    },
    "kind": { "enum": ["generated", "external", "derived"] },
    "codecs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "purposes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "standards": {
      "type": "array",
      "items": { "$ref": "#/$defs/standard" }
    },
    "license": { "$ref": "#/$defs/license" },
    "rights": { "$ref": "#/$defs/rights" },
    "source": { "$ref": "#/$defs/source" },
    "materialization": { "$ref": "#/$defs/materialization" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./-]*[a-z0-9]$"
    },
    "permission": {
      "enum": ["permitted", "prohibited", "conditional", "unknown"]
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "role"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "clauses": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "name", "evidence_url", "reviewed_on", "notes"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "local_files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_url": { "type": "string", "format": "uri" },
        "reviewed_on": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access", "redistribution", "modification", "commercial_use",
        "publish_derivatives", "publish_benchmarks", "ml_training",
        "weights_redistribution", "notes"
      ],
      "properties": {
        "access": { "$ref": "#/$defs/permission" },
        "redistribution": { "$ref": "#/$defs/permission" },
        "modification": { "$ref": "#/$defs/permission" },
        "commercial_use": { "$ref": "#/$defs/permission" },
        "publish_derivatives": { "$ref": "#/$defs/permission" },
        "publish_benchmarks": { "$ref": "#/$defs/permission" },
        "ml_training": { "$ref": "#/$defs/permission" },
        "weights_redistribution": { "$ref": "#/$defs/permission" },
        "notes": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landing_page", "terms_url", "requires_manual_acquisition"],
      "properties": {
        "landing_page": { "type": "string", "format": "uri" },
        "download_url": { "type": "string", "format": "uri" },
        "terms_url": { "type": "string", "format": "uri" },
        "upstream_revision": { "type": "string" },
        "archive_filename": { "type": "string" },
        "archive_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "requires_manual_acquisition": { "type": "boolean" }
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "layout", "notes"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "generator": { "type": "string" },
        "expected_tree_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "layout": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "media_type", "semantics"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "semantics": { "type": "string", "minLength": 1 }
      }
    }
  }
}
